---
import { useTranslations, type Locale } from '../i18n/ui';
import { videos } from '../data/videos';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = useTranslations(locale);

const featured = videos[0];
---

<section class="section featured-single-section">
  <div class="container">
    <div class="featured-single">
      <div class="featured-single-art">
        <iframe
          class="featured-single-video"
          src={`https://www.youtube-nocookie.com/embed/${featured.youTubeId}`}
          title={featured.title}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>
      <div class="featured-single-text">
        <span class="mag-label">{t('music.featuredLabel')}</span>
        <h3 class="featured-single-title">Take The Money</h3>
        <p class="featured-single-artist">The Midnight Calls</p>
        <a
          href={`https://www.youtube.com/watch?v=${featured.youTubeId}`}
          target="_blank"
          rel="noopener"
          class="btn-youtube"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814ZM9.545 15.568V8.432L15.818 12l-6.273 3.568Z"/>
          </svg>
          {t('music.featuredCta')}
        </a>
      </div>
    </div>
  </div>
</section>
