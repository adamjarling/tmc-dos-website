---
import { Image } from 'astro:assets';
import { useTranslations, type Locale } from '../i18n/ui';
import { videos } from '../data/videos';
import { singles } from '../data/singles';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = useTranslations(locale);

const featuredVideo = videos[0];
const featuredSingle = singles[0];

const coverModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/covers/*.{jpg,jpeg,png}',
  { eager: true },
);
const coverByName = Object.fromEntries(
  Object.entries(coverModules).map(([path, mod]) => [path.split('/').pop()!, mod.default]),
);
const cover = featuredSingle.cover ? coverByName[featuredSingle.cover] : undefined;

type Chip = { label: string; href: string };
const streamChips: Chip[] = featuredSingle.links ? [
  featuredSingle.links.spotify  && { label: 'Spotify',     href: featuredSingle.links.spotify },
  featuredSingle.links.apple    && { label: 'Apple Music', href: featuredSingle.links.apple },
  featuredSingle.links.bandcamp && { label: 'Bandcamp',    href: featuredSingle.links.bandcamp },
  featuredSingle.links.youtube  && { label: 'YouTube',     href: featuredSingle.links.youtube },
].filter((c): c is Chip => Boolean(c)) : [];
---

<section class="section featured-single-section">
  <div class="container">
    <div class="featured-single">
      <div>
        <span class="mag-label">{t('music.featuredVideoLabel')}</span>
        <div class="featured-single-art">
          <iframe
            class="featured-single-video"
            src={`https://www.youtube-nocookie.com/embed/${featuredVideo.youTubeId}`}
            title={featuredVideo.title}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
      </div>
      <div class="featured-single-text">
        <span class="mag-label">{t('music.featuredSingleLabel')}</span>
        <div class="featured-single-body">
          {cover && (
            <div class="featured-single-cover">
              <Image src={cover} alt={featuredSingle.title} widths={[160, 320]} />
            </div>
          )}
          <div>
            <h3 class="featured-single-title">{featuredSingle.title}</h3>
            <p class="featured-single-artist">The Midnight Calls</p>
            {streamChips.length > 0 && (
              <div class="featured-single-chips">
                {streamChips.map((chip) => (
                  <a href={chip.href} target="_blank" rel="noopener" class="stream-chip">
                    {chip.label}
                  </a>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
