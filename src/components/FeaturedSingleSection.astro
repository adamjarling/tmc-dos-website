---
import { Image } from 'astro:assets';
import { useTranslations, type Locale } from '../i18n/ui';
import { singles } from '../data/singles';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = useTranslations(locale);

const featured = singles[0];

const coverModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/covers/*.{jpg,jpeg,png}',
  { eager: true },
);
const coverByName = Object.fromEntries(
  Object.entries(coverModules).map(([path, mod]) => {
    const name = path.split('/').pop()!;
    return [name, mod.default];
  }),
);

const featuredCover = featured.cover ? coverByName[featured.cover] : undefined;
---

{featured.links?.spotify && (
  <section class="section featured-single-section">
    <div class="container">
      <div class="featured-single">
        <div class="featured-single-art">
          {featuredCover && (
            <Image src={featuredCover} alt={featured.title} class="featured-single-img" widths={[200, 400]} />
          )}
        </div>
        <div class="featured-single-text">
          <span class="mag-label">{t('music.featuredLabel')}</span>
          <h3 class="featured-single-title">{featured.title}</h3>
          <p class="featured-single-artist">The Midnight Calls</p>
          <a href={featured.links.spotify} target="_blank" rel="noopener" class="btn-spotify">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.494 17.278a.75.75 0 01-1.032.25c-2.822-1.727-6.376-2.117-10.56-1.16a.75.75 0 01-.334-1.463c4.578-1.044 8.504-.596 11.676 1.341a.75.75 0 01.25 1.032zm1.467-3.26a.937.937 0 01-1.29.308c-3.228-1.984-8.148-2.56-11.97-1.4a.938.938 0 01-.54-1.795c4.365-1.319 9.79-.68 13.49 1.597a.937.937 0 01.31 1.29zm.126-3.395c-3.87-2.299-10.252-2.51-13.946-1.389a1.125 1.125 0 01-.652-2.153c4.243-1.287 11.29-1.038 15.738 1.607a1.125 1.125 0 01-1.14 1.935z"/>
            </svg>
            {t('music.featuredCta')}
          </a>
        </div>
      </div>
    </div>
  </section>
)}
