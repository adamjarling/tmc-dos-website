---
import { useTranslations, pickLocale, type Locale } from '../i18n/ui';
import { pressQuotes } from '../data/press';
import { Image } from 'astro:assets';
import classicRockLogo from '../assets/media/classic-rock-logo.png';
import popular1Cover from '../assets/media/popular1-cover.jpg';
import popular1Review from '../assets/media/popular1-review.jpg';
import popular1InterviewPhoto from '../assets/media/popular1-interview.jpg';
import popular1InterviewCover from '../assets/media/popular1-interview-cover.jpg';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = useTranslations(locale);

const [crQuote, p1Quote, tmcQuote] = pressQuotes;
---

<section id="press" class="section">
  <div class="container">
    <span class="mag-label">{t('press.label')}</span>
    <h2 class="mag-heading">{t('press.heading')}</h2>

    <!-- Popular 1 featured spread -->
    <div class="press-featured">
      <div class="press-mags">
        <Image src={popular1Review} alt="Popular 1 review of The Midnight Calls" class="p1-review" />
        <Image src={popular1Cover} alt="Popular 1 magazine cover" class="p1-cover" />
      </div>
      <div class="press-featured-quote">
        <p class="press-text">"{pickLocale(p1Quote.text, locale)}"</p>
        <p class="press-src">— {p1Quote.source}</p>
      </div>
    </div>

    <!-- Popular 1 interview spread -->
    <div class="press-featured">
      <div class="press-mags">
        <Image src={popular1InterviewPhoto} alt="Popular 1 interview with The Midnight Calls" class="p1i-photo" />
        <Image src={popular1InterviewCover} alt="Popular 1 interview cover" class="p1i-cover" />
      </div>
      <div class="press-featured-quote">
        <span class="press-src" style="margin-bottom:12px">{t('press.interviewLabel')}</span>
        <p class="press-src">— {t('press.interviewSrc')}</p>
      </div>
    </div>

    <!-- Classic Rock + TMC -->
    <div class="press-grid">
      <div class="press-q press-q--cr">
        <Image src={classicRockLogo} alt="Classic Rock Magazine" class="cr-logo" />
        <p class="press-text">"{pickLocale(crQuote.text, locale)}"</p>
        <p class="press-src">— {crQuote.source}</p>
      </div>
      <div class="press-q">
        <p class="press-text">"{pickLocale(tmcQuote.text, locale)}"</p>
        <p class="press-src">— {tmcQuote.source}</p>
      </div>
    </div>

    <p style="color:var(--muted);margin-bottom:20px;font-size:15px">{t('press.intro')}</p>
    <div class="epk-row">
      <a href="mailto:themidnightcallsofficial@gmail.com" class="btn-outline">{t('press.contact')}</a>
      <a href="/press" class="btn-filled">{t('press.epk')}</a>
    </div>
  </div>
</section>
