---
import { useTranslations, type Locale } from '../i18n/ui';
import { Image } from 'astro:assets';
import lestratoLogo from '../assets/media/lestrato_logo.jpg';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = useTranslations(locale);
const successUrl = locale === 'es'
  ? 'https://themidnightcalls.com/es/success'
  : 'https://themidnightcalls.com/success';

const formOptions = JSON.stringify({
  settings: {
    after_subscribe: { action: 'redirect', success_message: 'Success! Now check your email to confirm your subscription.', redirect_url: successUrl },
    analytics: { google: null, fathom: null, facebook: null, segment: null, pinterest: null, sparkloop: null, googletagmanager: null },
    modal: { trigger: 'timer', scroll_percentage: null, timer: 5, devices: 'all', show_once_every: 15 },
    powered_by: { show: true, url: 'https://kit.com/features/forms?utm_campaign=poweredby&utm_content=form&utm_medium=referral&utm_source=dynamic' },
    recaptcha: { enabled: false },
    return_visitor: { action: 'show', custom_content: '' },
    slide_in: { display_in: 'bottom_right', trigger: 'timer', scroll_percentage: null, timer: 5, devices: 'all', show_once_every: 15 },
    sticky_bar: { display_in: 'top', trigger: 'timer', scroll_percentage: null, timer: 5, devices: 'all', show_once_every: 15 },
  },
  version: '5',
});
---

<section id="contact" class="section alt-bg contact-section">
  <div class="container">
    <span class="mag-label">{t('contact.label')}</span>
    <h2 class="mag-heading">{t('contact.heading')}</h2>
    <div class="contact-inner">
      <p class="contact-sub">{t('contact.sub')}</p>

      <script is:inline src="https://f.convertkit.com/ckjs/ck.5.js"></script>
      <form action="https://app.kit.com/forms/9391150/subscriptions" class="seva-form formkit-form" method="post" data-sv-form="9391150" data-uid="435787c158" data-format="inline" data-version="5" data-options={formOptions} min-width="400 500 600 700 800">
        <div data-style="clean">
          <ul class="formkit-alert formkit-alert-error" data-element="errors" data-group="alert"></ul>
          <div data-element="fields" data-stacked="false" class="seva-fields formkit-fields">
            <div class="formkit-field">
              <input class="formkit-input" name="email_address" aria-label="Email Address" placeholder={t('contact.placeholder')} required type="email" />
            </div>
            <button data-element="submit" class="formkit-submit formkit-submit">
              <div class="formkit-spinner"><div></div><div></div><div></div></div>
              <span>{t('contact.subscribe')}</span>
            </button>
          </div>
          <div class="formkit-powered-by-convertkit-container">
            <a href="https://kit.com/features/forms?utm_campaign=poweredby&utm_content=form&utm_medium=referral&utm_source=dynamic" data-element="powered-by" class="formkit-powered-by-convertkit" data-variant="dark" target="_blank" rel="nofollow noopener">Built with Kit</a>
          </div>
        </div>
      </form>

      <p class="contact-email-label">{t('contact.emailLabel')}</p>
      <p class="contact-email-wrap">
        <span id="contact-email"></span>
      </p>

      <div class="booking-card">
        <p class="contact-email-label">{t('contact.bookingLabel')}</p>
        <a href="https://www.facebook.com/lestrato.rockconciertos/" target="_blank" rel="noopener" class="booking-logo-link">
          <Image src={lestratoLogo} alt="Lestrato Rock Conciertos" class="booking-logo" />
        </a>
        <p class="booking-name">Lestrato Rock Conciertos</p>
        <p class="contact-email-wrap"><span id="booking-email"></span></p>
        <a href="https://www.facebook.com/lestrato.rockconciertos/" target="_blank" rel="noopener" class="booking-social">Facebook</a>
      </div>

      <script>
        const u = 'themidnightcallsofficial';
        const d = 'gmail' + '.' + 'com';
        const el = document.getElementById('contact-email');
        if (el) el.innerHTML = '<a href="mailto:' + u + '@' + d + '">' + u + '@' + d + '</a>';

        const bu = 'info';
        const bd = 'lestrato' + '.' + 'com';
        const bel = document.getElementById('booking-email');
        if (bel) bel.innerHTML = '<a href="mailto:' + bu + '@' + bd + '">' + bu + '@' + bd + '</a>';
      </script>
    </div>
  </div>
</section>

<style>
  /* :global() required — Kit elements are injected by third-party JS and don't carry Astro's scoping attribute */
  :global(.formkit-form) {
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    max-width: 100% !important;
    font-family: 'DM Sans', sans-serif !important;
  }
  /* Constrain form to a proportional width and centre it */
  :global(.formkit-form[data-format="inline"]) {
    width: 100% !important;
    max-width: 480px !important;
    margin-left: auto !important;
    margin-right: auto !important;
  }

  /* Side-by-side layout — grid overrides Kit's flex stacking and JS-injected widths */
  :global(.seva-fields.formkit-fields) {
    display: grid !important;
    grid-template-columns: 1fr auto !important;
    gap: 0 !important;
    align-items: stretch !important;
    margin: 0 !important;
    width: 100% !important;
  }
  :global(.seva-fields .formkit-field) {
    margin: 0 !important;
    width: 100% !important;
    min-width: 0 !important;
  }
  :global(.seva-fields .formkit-input) {
    width: 100% !important;
    box-sizing: border-box !important;
  }
  :global(.seva-fields .formkit-submit) { margin: 0 !important; width: auto !important; }

  :global(.formkit-input) {
    background: rgba(255, 255, 255, 0.05) !important;
    border: 1px solid rgba(240, 236, 239, 0.09) !important;
    border-right: none !important;
    border-radius: 0 !important;
    color: #f0ecef !important;
    font-family: 'DM Sans', sans-serif !important;
    font-size: 14px !important;
    padding: 13px 18px !important;
  }
  :global(.formkit-input::placeholder) { color: #8c7e89 !important; }
  :global(.formkit-input:focus) {
    border-color: rgba(232, 24, 106, 0.4) !important;
    outline: none !important;
    box-shadow: none !important;
  }
  :global(.formkit-submit) {
    background: #e8186a !important;
    border: 1px solid #e8186a !important;
    border-radius: 0 !important;
    color: #fff !important;
    font-family: 'DM Sans', sans-serif !important;
    font-size: 13px !important;
    font-weight: 500 !important;
    letter-spacing: 1.5px !important;
    text-transform: uppercase !important;
    transition: all 0.2s !important;
  }
  :global(.formkit-submit:hover) {
    background: #c41059 !important;
    border-color: #c41059 !important;
  }
  :global(.formkit-submit > span) { padding: 13px 28px !important; }
  :global(.formkit-powered-by-convertkit-container) {
    margin-top: 14px !important;
    justify-content: center !important;
    opacity: 0.4 !important;
  }

  .contact-email-label {
    margin-top: 40px;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .contact-email-wrap {
    margin-top: 6px;
    font-family: var(--bf);
    font-size: 15px;
  }
  .contact-email-wrap a {
    color: var(--pink);
    text-decoration: none;
  }
  .contact-email-wrap a:hover { text-decoration: underline; }

  .booking-card {
    margin-top: 48px;
    padding-top: 40px;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }
  .booking-logo-link { display: inline-block; margin: 12px 0 4px; }
  .booking-logo { height: 64px; width: auto; object-fit: contain; }
  .booking-name {
    font-family: var(--hf);
    font-size: 16px;
    letter-spacing: 1px;
    margin-top: 4px;
  }
  .booking-social {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
  }
  .booking-social:hover { color: var(--pink); }
</style>
