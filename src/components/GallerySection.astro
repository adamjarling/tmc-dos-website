---
import { Image } from 'astro:assets';
import { useTranslations, pickLocale, type Locale } from '../i18n/ui';
import { livePhotos } from '../data/photos';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = useTranslations(locale);

const photoModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/photos/*.{jpg,jpeg,png}',
  { eager: true },
);
const photoByName = Object.fromEntries(
  Object.entries(photoModules).map(([path, mod]) => [path.split('/').pop()!, mod.default]),
);
---

<section id="gallery" class="section alt-bg">
  <div class="container">
    <span class="mag-label">{t('gallery.label')}</span>
    <h2 class="mag-heading">{t('gallery.heading')}</h2>
    <div class="photo-grid" id="photo-grid">
      {livePhotos.map((p) => {
        const img = photoByName[p.file];
        if (!img) return null;
        return (
          <div class="photo-item">
            <Image src={img} alt={pickLocale(p.alt, locale) ?? ''} widths={[600, 1200]} loading="lazy" />
            <div class="photo-caption">{pickLocale(p.alt, locale)}</div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<script>
  const grid = document.getElementById('photo-grid');
  if (grid) {
    const items = Array.from(grid.children);
    for (let i = items.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [items[i], items[j]] = [items[j], items[i]];
    }
    for (const item of items) grid.appendChild(item);
  }
</script>
