---
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/ui';
import successPhoto from '../../assets/photos/20250608_005042.jpg';

const t = useTranslations('es');
---

<Layout title="¡Ya Estás Dentro!" description="Gracias por suscribirte a la lista de correo de The Midnight Calls.">
  <section class="success-page">
    <div class="success-photo">
      <img src={successPhoto.src} alt="The Midnight Calls con sus fans después de un concierto" />
      <div class="success-overlay"></div>
    </div>
    <div class="success-content">
      <span class="mag-label">{t('contact.label')}</span>
      <h1 class="success-heading">{t('success.heading')}</h1>
      <p class="success-sub">{t('success.sub')}</p>
      <p class="success-body">{t('success.body')}</p>
      <a href="/es/" class="btn-outline btn-sm success-back">{t('success.back')}</a>
    </div>
  </section>
</Layout>

<style>
  .success-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }
  .success-photo {
    position: absolute;
    inset: 0;
  }
  .success-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }
  .success-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(9, 7, 11, 0.5) 0%,
      rgba(9, 7, 11, 0.85) 60%,
      rgba(9, 7, 11, 0.95) 100%
    );
  }
  .success-content {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 600px;
    padding: 160px 28px 80px;
  }
  .success-heading {
    font-family: var(--hf);
    font-size: clamp(56px, 8vw, 96px);
    letter-spacing: 2px;
    line-height: 1;
    color: var(--pink);
    margin-bottom: 20px;
  }
  .success-sub {
    font-family: var(--bf);
    font-size: 18px;
    color: var(--text);
    margin-bottom: 16px;
  }
  .success-body {
    color: var(--muted);
    font-size: 15px;
    line-height: 1.7;
    margin-bottom: 40px;
  }
  .success-back {
    display: inline-block;
  }
</style>
